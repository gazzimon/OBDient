# OBDient environment variables — template
# Copy to .env and fill in your own values.  (.env is gitignored)
#
# AI inference runs 100% ON-DEVICE via the QVAC SDK (@qvac/sdk).
# No inference server, no base URL, no model env var — the model is
# selected in code at src/data/datasources/qvac-sdk.datasource.ts

# Vincario VIN Decoder API (optional — used by vincario.datasource.ts)
EXPO_PUBLIC_VINCARIO_API_KEY=your_vincario_api_key
EXPO_PUBLIC_VINCARIO_SECRET_KEY=your_vincario_secret_key

# Anthropic Claude API (optional — cloud fallback for general questions + quality eval)
# Can also be set at runtime in Settings → Claude AI (runtime key takes priority).
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key
